properties([
  pipelineTriggers([
    githubPush()
  ])
])

pipeline {
  agent any

  environment {
    AWS_REGION = 'us-east-1'
    ECR_REPO = 'poc-aitestgen'
    IMAGE_TAG = "api-stage.${env.BUILD_NUMBER}"
    KUBECONFIG = credentials('kubeconfig-credential-id')
    K8S_PATH = "ops/k8s"
  }

  stages {

    stage('Build Docker Image') {
      steps {
        script {
          withAWS(region: AWS_REGION, credentials: 'wm-ps-user-ecr') {

            def awsAccountID = sh(returnStdout: true, script: """
              aws sts get-caller-identity --query Account --output text
            """).trim()

            sh """
              aws ecr get-login-password --region ${AWS_REGION} \
                | docker login --username AWS --password-stdin ${awsAccountID}.dkr.ecr.${AWS_REGION}.amazonaws.com
            """

            sh """
              docker build \
                -t ${ECR_REPO}:${IMAGE_TAG} \
                -f apps/api/Dockerfile \
                .
            """
          }
        }
      }
    }

    stage('Push Docker Image') {
      steps {
        script {
          withAWS(region: AWS_REGION, credentials: 'wm-ps-user-ecr') {

            def awsAccountID = sh(returnStdout: true, script: """
              aws sts get-caller-identity --query Account --output text
            """).trim()

            def fullImage = "${awsAccountID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}"

            sh "docker tag ${ECR_REPO}:${IMAGE_TAG} ${fullImage}"
            sh "docker push ${fullImage}"
          }
        }
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        script {
          withAWS(region: AWS_REGION, credentials: 'wm-ps-user-ecr') {

            def awsAccountID = sh(returnStdout: true, script: """
              aws sts get-caller-identity --query Account --output text
            """).trim()

            def image = "${awsAccountID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}"

            // `sed -i` on the tracked manifest only works once per workspace:
            // after the first run replaces REPLACE_IMAGE, the placeholder is
            // gone from the checked-out copy, so every later run's sed is a
            // silent no-op and `kubectl apply` keeps re-applying the SAME
            // old image forever, no matter how many new images get built.
            // Render into an untracked file instead so REPLACE_IMAGE in git
            // is never touched, and use `kubectl set image` as the actual
            // trigger so a rollout always happens even if the rendered spec
            // is otherwise identical to what's already applied.
            sh """
              sed 's|REPLACE_IMAGE|${image}|' ${K8S_PATH}/06-api.yaml > ${K8S_PATH}/06-api.rendered.yaml
            """

            sh "kubectl apply -f ${K8S_PATH}/06-api.rendered.yaml"
            sh "kubectl set image deployment/api api=${image} -n aitestgen"
            sh "kubectl rollout status deployment/api -n aitestgen --timeout=120s"
            sh "kubectl apply -f ${K8S_PATH}/06-api-ingress.yaml"
          }
        }
      }
    }

    // Nothing else ever ran this against the RDS Postgres in 06-api.yaml's
    // DATABASE_URL — tables from migrations/versions never reached it, so
    // endpoints touching those tables 500'd (e.g. /auth/login querying
    // platformuser). The api image already has alembic.ini + migrations/
    // (Dockerfile COPYs the whole repo), so run it in the container that
    // already has the real DATABASE_URL wired in via env, rather than
    // duplicating DB connection setup on the Jenkins agent.
    stage('Run Database Migrations') {
      steps {
        script {
          withAWS(region: AWS_REGION, credentials: 'wm-ps-user-ecr') {
            sh "kubectl exec deployment/api -n aitestgen -- /app/.venv/bin/alembic upgrade head"
          }
        }
      }
    }
  }
}
