  "cards": [
    {
      "dot": "cyan",
      "title": "How it explores",
      "items": [
        "Real Chromium browser, signed in with the app's saved login",
        "An AI model reads each screen and picks the next step",
        "Missions walk whole business tasks, a few at a time"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why scenarios are trusted",
      "items": [
        "Each scenario is tried in the app first",
        "Replayed with its key step removed: the check must fail",
        "Then replayed clean: it must pass every time"
      ]
    },
    {
      "dot": "rose",
      "title": "You stay in control",
      "items": [
        "Pause, Resume or Stop at any time",
        "A Goal limits what it explores",
        "It never confirms or answers for you"
      ]
    }
  ]
