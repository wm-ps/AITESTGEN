{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Vantage Explorer — System Architecture",
    "subtitle": "Deployables, stores and external services behind one Explorer run",
    "output": "explorer-system.html",
    "quality_profile": "standard",
    "views": [
      {
        "id": "start",
        "label": "Start a run",
        "focus": [
          "user",
          "web",
          "api",
          "temporal",
          "worker"
        ],
        "note": "The Start card calls the API, which starts ExplorerRunWorkflow on Temporal; the Explorer worker picks it up."
      },
      {
        "id": "explore",
        "label": "Explore the app",
        "focus": [
          "worker",
          "vault",
          "chromium",
          "aut",
          "llm",
          "postgres"
        ],
        "note": "Signs in with the Vault login, drives headless Chromium, asks GPT-5.6 to read and act, journals to Postgres."
      },
      {
        "id": "watch",
        "label": "Watch and answer",
        "focus": [
          "user",
          "web",
          "api",
          "postgres",
          "worker",
          "smtp"
        ],
        "note": "The tab polls the API for events, screens, questions and tests; the worker emails the starter when it needs them."
      },
      {
        "id": "handoff",
        "label": "Hand off to Vantage",
        "focus": [
          "worker",
          "classic",
          "postgres"
        ],
        "note": "Proven tests are promoted into classic Journeys and Scenarios; the generation worker reuses Explorer's proven Playwright code."
      }
    ]
  },
