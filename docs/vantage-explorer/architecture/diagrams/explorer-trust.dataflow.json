{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Explorer Trust Model — Where 'Correct' Comes From",
    "subtitle": "The app is evidence, never the truth: expectations come from trusted sources",
    "output": "explorer-trust.html",
    "quality_profile": "standard",
    "viewBox": [
      1080,
      720
    ]
  },
  "stages": [
    {
      "label": "Sources"
    },
    {
      "label": "Remembered"
    },
    {
      "label": "Before / after"
    },
    {
      "label": "Compare"
    },
    {
      "label": "Outcome"
    }
  ],
  "nodes": [
    {
      "id": "answers",
      "type": "frontend",
      "label": "Your answers",
      "stage": 0,
      "row": 0,
      "sublabel": "trust: confirmed"
    },
    {
      "id": "docs",
      "type": "frontend",
      "label": "Your docs",
      "stage": 0,
      "row": 1,
      "sublabel": "PDF · Word · text"
    },
    {
      "id": "sense",
      "type": "cloud",
      "label": "Common sense",
      "stage": 0,
      "row": 2,
      "sublabel": "trust: standard"
    },
    {
      "id": "app",
      "type": "external",
      "label": "What app does",
      "stage": 0,
      "row": 4,
      "sublabel": "trust: seen only"
    },
    {
      "id": "memory",
      "type": "database",
      "label": "Memory",
      "stage": 1,
      "row": 0,
      "sublabel": "per app, all runs"
    },
    {
      "id": "brief",
      "type": "database",
      "label": "App Summary",
      "stage": 1,
      "row": 1,
      "sublabel": "you confirmed"
    },
    {
      "id": "screens",
      "type": "database",
      "label": "Screens + map",
      "stage": 1,
      "row": 4,
      "sublabel": "explorer_screen"
    },
    {
      "id": "expected",
      "type": "backend",
      "label": "Expected",
      "stage": 2,
      "row": 1,
      "sublabel": "written first"
    },
    {
      "id": "observed",
      "type": "backend",
      "label": "Observed",
      "stage": 2,
      "row": 3,
      "sublabel": "after acting"
    },
    {
      "id": "compare",
      "type": "security",
      "label": "Compare",
      "stage": 3,
      "row": 2,
      "sublabel": "judge · prove"
    },
    {
      "id": "proven",
      "type": "database",
      "label": "Proven test",
      "stage": 4,
      "row": 0,
      "sublabel": "status proven"
    },
    {
      "id": "knownbug",
      "type": "database",
      "label": "Known-bug test",
      "stage": 4,
      "row": 2,
      "sublabel": "test.fixme"
    },
    {
      "id": "question",
      "type": "messagebus",
      "label": "Bug question",
      "stage": 4,
      "row": 4,
      "sublabel": "never blocks"
    }
  ],
  "flows": [
    {
      "id": "answers-memory",
      "from": "answers",
      "to": "memory",
      "label": "facts",
      "variant": "emphasis"
    },
    {
      "id": "docs-memory",
      "from": "docs",
      "to": "memory",
      "label": "chunks"
    },
    {
      "id": "sense-expected",
      "from": "sense",
      "to": "expected",
      "label": "rules",
      "route": "vertical-channel",
      "channelX": 420
    },
    {
      "id": "app-screens",
      "from": "app",
      "to": "screens",
      "label": "evidence",
      "variant": "dashed"
    },
    {
      "id": "memory-expected",
      "from": "memory",
      "to": "expected",
      "label": "prompts",
      "variant": "emphasis"
    },
    {
      "id": "brief-expected",
      "from": "brief",
      "to": "expected",
      "label": "scope"
    },
    {
      "id": "screens-observed",
      "from": "screens",
      "to": "observed",
      "label": "replay",
      "variant": "dashed"
    },
    {
      "id": "expected-compare",
      "from": "expected",
      "to": "compare",
      "label": "should",
      "variant": "emphasis"
    },
    {
      "id": "observed-compare",
      "from": "observed",
      "to": "compare",
      "label": "did"
    },
    {
      "id": "compare-proven",
      "from": "compare",
      "to": "proven",
      "label": "match",
      "variant": "emphasis"
    },
    {
      "id": "compare-knownbug",
      "from": "compare",
      "to": "knownbug",
      "label": "test differs",
      "variant": "security"
    },
    {
      "id": "compare-question",
      "from": "compare",
      "to": "question",
      "label": "mission differs",
      "variant": "dashed"
    }
  ],
  "cards": []
}