{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Explorer Run — Status Lifecycle",
    "subtitle": "explorer_run.status from queued to tested, with the human checkpoint and pause/resume",
    "output": "explorer-run-lifecycle.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Run stages"
    },
    {
      "id": "waiting",
      "label": "Waits on a person"
    },
    {
      "id": "terminal",
      "label": "Where a run ends"
    }
  ],
  "states": [
    {
      "id": "queued",
      "type": "start",
      "label": "Queued",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "begin_run"
    },
    {
      "id": "understanding",
      "type": "active",
      "label": "Understanding",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "sign in · look · summarize"
    },
    {
      "id": "planning",
      "type": "active",
      "label": "Planning",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "Mission Board"
    },
    {
      "id": "exploring",
      "type": "active",
      "label": "Exploring",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "missions · hunt · breadth"
    },
    {
      "id": "testing",
      "type": "active",
      "label": "Testing",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "build · prove"
    },
    {
      "id": "awaiting",
      "type": "waiting",
      "label": "Awaiting confirm",
      "lane": "waiting",
      "col": 0,
      "tag": "up to 14 days"
    },
    {
      "id": "paused",
      "type": "waiting",
      "label": "Paused",
      "lane": "waiting",
      "col": 1,
      "tag": "Resume picks up"
    },
    {
      "id": "tested",
      "type": "success",
      "label": "Tested",
      "lane": "terminal",
      "col": 2,
      "tag": "promote · reel"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "lane": "terminal",
      "col": 0,
      "tag": "visible error"
    },
    {
      "id": "stopped",
      "type": "failure",
      "label": "Stopped",
      "lane": "terminal",
      "col": 1,
      "tag": "user pressed Stop"
    }
  ],
  "transitions": [
    {
      "id": "q-u",
      "from": "queued",
      "to": "understanding",
      "variant": "emphasis"
    },
    {
      "id": "u-a",
      "from": "understanding",
      "to": "awaiting",
      "label": "summary ready",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "a-p",
      "from": "awaiting",
      "to": "planning",
      "label": "you confirm",
      "variant": "security",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "p-e",
      "from": "planning",
      "to": "exploring",
      "variant": "emphasis"
    },
    {
      "id": "e-t",
      "from": "exploring",
      "to": "testing",
      "variant": "emphasis"
    },
    {
      "id": "t-done",
      "from": "testing",
      "to": "tested",
      "label": "done",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "e-pause",
      "from": "exploring",
      "to": "paused",
      "label": "pause",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "u-fail",
      "from": "understanding",
      "to": "failed",
      "label": "can't sign in",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "left",
      "via": [
        [
          171,
          157
        ],
        [
          171,
          479
        ]
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Hidden statuses",
      "items": [
        "signing_in, summarizing inside step 02",
        "confirmed, explored, hunting between steps",
        "Each has its own live headline"
      ]
    },
    {
      "dot": "amber",
      "title": "Pause vs Stop",
      "items": [
        "Both cancel the Temporal workflow",
        "Resume: workflow mode=resume",
        "Cut-off missions/tests go back to queue"
      ]
    }
  ]
}